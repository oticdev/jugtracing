<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.naijajug</groupId>
        <artifactId>jugtracing</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>observability-support</artifactId>
    <name>observability-support</name>
    <description>Shared OpenTelemetry setup: OTLP export, log appender, noise filtering</description>

    <dependencies>
        <!-- Micrometer Observation -> OpenTelemetry bridge -> OTLP (traces, logs) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <!-- Compile-time access to the Micrometer -> OTel bridge (BaggageTaggingSpanProcessor) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!-- Sends Logback events to the OpenTelemetry SDK, which exports them over OTLP -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
        </dependency>
        <!-- Only needed to compile the HTTP noise filter; every service brings its own spring-web -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
